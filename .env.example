# ateam configuration (all optional; sane defaults applied)

# HTTP + WebSocket server port
ATEAM_PORT=4319

# SQLite database file location
ATEAM_DB=./data/ateam.sqlite

# Default model assigned to new agents (overridable per agent).
# Use 'auto' for guaranteed availability; pick a specific model per agent in the UI
# (the app lists the models actually enabled on your Copilot account).
ATEAM_DEFAULT_MODEL=auto

# Comma-separated extra home roots to scan for skills (SKILL.md).
# Defaults already include ~/.agents/skills and ~/.pi. Example:
# ATEAM_SKILL_HOME_ROOTS=C:\Users\me\.agents\skills,C:\Users\me\.pi

# Set to 1 to use the deterministic Fake Copilot adapter (offline, no LLM).
# Used by the test suite automatically; handy for UI development without burning tokens.
ATEAM_FAKE_SDK=0

# Where per-epic git worktrees are created. MUST be outside any project/app repo.
# Defaults to <os-temp>/ateam-worktrees (always resolved to an absolute path).
# ATEAM_WORKTREE_ROOT=

# Commit-message convention the harness emits for every generated commit.
#   ateam        (default) -> "ateam: merge ...", "task(backend): ..."
#   conventional           -> "chore(merge): ...", "fix(backend): ..." (Conventional Commits)
# Use 'conventional' for repos that enforce Conventional Commits.
# ATEAM_COMMIT_STYLE=ateam

# Set to 1 to record every agent turn (exact prompt + reply + tool events) to
# <recordingsDir>/<projectId>/sessions.jsonl by default for NEW projects. Useful
# for headless/live runs where you can't toggle the per-project setting in the UI.
# ATEAM_RECORD_SESSIONS=0

# Max child tasks of ONE epic allowed to run concurrently (independent streams
# run in parallel, each in its own isolated task clone; integration back into
# the epic branch is serialized). Default 3.
# ATEAM_EPIC_CONCURRENCY=3

# Per-epic review-round budget: after this many review rounds with still-open
# comments, the epic parks and asks the user (merge anyway / keep working)
# instead of silently merging past them. Default 3.
# ATEAM_MAX_REVIEW_ITER=3

# Per-epic CUMULATIVE review-fix budget: once this many review-fix tasks have been
# created across all rounds (or the round cap above is hit), the epic parks and asks
# the user instead of grinding forever. Bounds the case where a round never
# completes under a single serial owner. Default 12.
# ATEAM_MAX_REVIEW_FIXES=12

# Stall watchdog: if the board hasn't moved for this long with open work and no
# agent working, the manager tries to self-heal (clear leaked run/park guards and
# re-drive) before diagnosing. Milliseconds; default 120000.
# ATEAM_STALL_MS=120000

# How long a task's run may stay flagged running with its agent idle before the
# stall watchdog treats it as a hung/crashed turn and clears the guard.
# Milliseconds; default 300000.
# ATEAM_RUN_WATCHDOG_MS=300000

# How long a contract-consuming builder (frontend/backend/data) waits for the
# Architect's shared-interface design to land before building anyway. Bounded so
# a stalled design turn never blocks throughput. Milliseconds; default 45000.
# ATEAM_DESIGN_WAIT_MS=45000

# Timeout for installing a gate directory's dependencies before build/test gates
# run there (integrated epic clone / fresh task clones). Milliseconds; default 300000.
# ATEAM_DEP_INSTALL_TIMEOUT_MS=300000
